# Local development port. The client expects the server on 3001 locally
# (client/.env VITE_API_URL=http://localhost:3001 and the Vite dev proxy).
# In production, Pxxl injects PORT automatically (see server/pxxl.toml) —
# do NOT set PORT in the Pxxl dashboard.
PORT=3001

# Server-side only — never exposed to the client. Required: the server
# exits on startup if this is missing.
ANTHROPIC_API_KEY=sk-ant-...
